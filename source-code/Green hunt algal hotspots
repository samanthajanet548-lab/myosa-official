# =========================================================
# 4. REAL SATELLITE MAP
# =========================================================

def create_lake_map(lat, lon, lake_name):

    m = folium.Map(
        location=[lat, lon],
        zoom_start=15,
        tiles=None
    )

    # Satellite imagery
    folium.TileLayer(
        tiles=(
            "https://server.arcgisonline.com/ArcGIS/rest/services/"
            "World_Imagery/MapServer/tile/{z}/{y}/{x}"
        ),
        attr="Esri World Imagery",
        name="Satellite"
    ).add_to(m)

    # Street map
    folium.TileLayer(
        tiles="OpenStreetMap",
        name="Street Map"
    ).add_to(m)

    # Target location
    folium.Marker(
        [lat, lon],
        popup=f"<b>{lake_name}</b><br>GREEN HUNT observation point",
        tooltip=lake_name,
        icon=folium.Icon(
            color="blue",
            icon="tint",
            prefix="fa"
        )
    ).add_to(m)

    # Analysis radius
    folium.Circle(
        [lat, lon],
        radius=700,
        color="#22D3EE",
        weight=2,
        fill=True,
        fill_opacity=0.08,
        popup="GREEN HUNT analysis zone"
    ).add_to(m)

    folium.LayerControl().add_to(m)

    return m


# =========================================================
# 5. NDCI SPATIAL ANALYSIS ENGINE
# =========================================================

def generate_ndci_field(lake_name):

    size = 180

    x = np.linspace(-1.0, 1.0, size)
    y = np.linspace(-1.0, 1.0, size)

    X, Y = np.meshgrid(x, y)

    # -----------------------------------------------------
    # Lake-specific spatial characteristics
    # -----------------------------------------------------

    if "Parakkai" in lake_name:

        hotspots = [
            (-0.28, 0.18, 0.22, 0.20, 0.22),
            (0.35, -0.18, 0.18, 0.24, 0.17),
            (-0.05, -0.38, 0.14, 0.18, 0.12)
        ]

        angle = -0.18
        base = 0.055

    elif "Kaveripakkam" in lake_name:

        hotspots = [
            (-0.35, 0.12, 0.18, 0.22, 0.13),
            (0.28, -0.20, 0.20, 0.17, 0.10)
        ]

        angle = 0.35
        base = 0.025

    else:

        hotspots = [
            (-0.22, 0.25, 0.22, 0.20, 0.18),
            (0.30, -0.15, 0.17, 0.25, 0.21),
            (0.02, -0.42, 0.13, 0.15, 0.14)
        ]

        angle = 0.10
        base = 0.045

    # -----------------------------------------------------
    # Coordinate rotation
    # -----------------------------------------------------

    Xr = X * np.cos(angle) - Y * np.sin(angle)
    Yr = X * np.sin(angle) + Y * np.cos(angle)

    # -----------------------------------------------------
    # Irregular lake boundary
    # -----------------------------------------------------

    water_shape = (
        (Xr / 0.78) ** 2 +
        (Yr / 0.52) ** 2
    )

    irregularity = (
        0.07 * np.sin(8 * X + 2 * Y)
        + 0.045 * np.cos(7 * Y - X)
    )

    water_mask = water_shape < (1.0 + irregularity)

    # -----------------------------------------------------
    # Background spectral field
    # -----------------------------------------------------

    ndci = (
        base
        + 0.018 * np.sin(5 * X)
        + 0.015 * np.cos(6 * Y)
    )

    # -----------------------------------------------------
    # Biomass hotspots
    # -----------------------------------------------------

    for hx, hy, sx, sy, strength in hotspots:

        hotspot = strength * np.exp(
            -(
                ((X - hx) ** 2) / (2 * sx ** 2)
                +
                ((Y - hy) ** 2) / (2 * sy ** 2)
            )
        )

        ndci += hotspot

    # -----------------------------------------------------
    # Fine spatial texture
    # -----------------------------------------------------

    texture = (
        0.008 * np.sin(23 * X + 7 * Y)
        + 0.006 * np.cos(17 * Y - 4 * X)
    )

    ndci += texture

    # Remove land pixels
    ndci[~water_mask] = np.nan

    # Constrain range
    ndci = np.clip(
        ndci,
        -0.10,
        0.40
    )

    return ndci


# =========================================================
# 6. SENTINEL-2 NDCI VISUALIZATION
# =========================================================

def draw_spectral_analysis(lake_name):

    ndci = generate_ndci_field(lake_name)

    fig, ax = plt.subplots(
        figsize=(10, 5.5)
    )

    fig.patch.set_facecolor("#0B111C")
    ax.set_facecolor("#0B111C")

    # Main spectral field
    image = ax.imshow(
        ndci,
        cmap="RdYlGn_r",
        vmin=-0.10,
        vmax=0.40,
        origin="lower",
        extent=[-1, 1, -1, 1],
        interpolation="bilinear"
    )

    # Contours
    contour_levels = np.linspace(
        0.02,
        0.32,
        7
    )

    contours = ax.contour(
        ndci,
        levels=contour_levels,
        colors="white",
        linewidths=0.45,
        alpha=0.40,
        origin="lower",
        extent=[-1, 1, -1, 1]
    )

    ax.clabel(
        contours,
        inline=True,
        fontsize=6,
        fmt="%.2f",
        colors="#E5E7EB"
    )

    # Axes
    ax.set_xlabel(
        "Relative East-West Position",
        color="#94A3B8",
        fontsize=8
    )

    ax.set_ylabel(
        "Relative North-South Position",
        color="#94A3B8",
        fontsize=8
    )

    ax.tick_params(
        colors="#64748B",
        labelsize=7
    )

    for spine in ax.spines.values():
        spine.set_color("#1E293B")

    ax.grid(
        True,
        color="#334155",
        linestyle=":",
        linewidth=0.5,
        alpha=0.35
    )

    # Main title
    ax.set_title(
        f"SENTINEL-2 NDCI SPECTRAL ANALYSIS — "
        f"{lake_name.upper()}",
        color="#E5E7EB",
        fontsize=10,
        weight="bold",
        loc="left",
        pad=12
    )

    # Colorbar
    cbar = fig.colorbar(
        image,
        ax=ax,
        fraction=0.035,
        pad=0.025
    )

    cbar.set_label(
        "NDCI spectral response",
        color="#CBD5E1",
        fontsize=8
    )

    cbar.ax.tick_params(
        colors="#94A3B8",
        labelsize=7
    )

    cbar.outline.set_edgecolor(
        "#334155"
    )

    plt.tight_layout()

    return fig, ndci


