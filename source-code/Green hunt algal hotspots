def draw_auv_route(lake_name):

    if "Parakkai" in lake_name:

        x = [-0.75, -0.45, -0.05, 0.32, 0.58]
        y = [-0.38, 0.02, 0.22, -0.05, 0.28]

    elif "Kaveripakkam" in lake_name:

        x = [-0.72, -0.35, 0.02, 0.36, 0.62]
        y = [-0.35, -0.05, 0.18, 0.02, 0.24]

    else:

        x = [-0.70, -0.38, -0.02, 0.30, 0.58]
        y = [-0.36, 0.05, 0.28, -0.02, 0.30]

    fig, ax = plt.subplots(
        figsize=(5.5, 4.0)
    )

    fig.patch.set_facecolor("#0B111C")
    ax.set_facecolor("#05080E")

    # Mission path
    ax.plot(
        x,
        y,
        color="#06B6D4",
        linestyle="--",
        linewidth=2,
        marker="o",
        markersize=5
    )

    # Launch
    ax.scatter(
        x[0],
        y[0],
        color="#10B981",
        s=90,
        zorder=5
    )

    # Target
    ax.scatter(
        x[-1],
        y[-1],
        color="#F97316",
        s=90,
        zorder=5
    )

    ax.text(
        x[0] - 0.08,
        y[0] - 0.10,
        "LAUNCH",
        color="#CBD5E1",
        fontsize=7,
        weight="bold"
    )

    ax.text(
        x[-1] + 0.02,
        y[-1] + 0.02,
        "TARGET",
        color="#CBD5E1",
        fontsize=7,
        weight="bold"
    )

    for i in range(
        1,
        len(x) - 1
    ):

        ax.text(
            x[i] + 0.025,
            y[i] + 0.025,
            f"WP-{i:02d}",
            color="#94A3B8",
            fontsize=6
        )

    ax.set_title(
        "VIRTUAL AUV INTERVENTION ROUTE",
        color="#E5E7EB",
        fontsize=9,
        weight="bold",
        loc="left"
    )

    ax.set_xlim(
        -0.9,
        0.85
    )

    ax.set_ylim(
        -0.55,
        0.55
    )

    ax.axis("off")

    plt.tight_layout()

    return fig


